---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Proyecto 1',
    description: 'Aplicación web para gestionar tareas.',
    link: 'https://github.com/TU_USUARIO/proyecto-1'
  },
  {
    title: 'Proyecto 2',
    description: 'Landing page moderna con Astro.',
    link: 'https://github.com/TU_USUARIO/proyecto-2'
  },
  {
    title: 'Proyecto 3',
    description: 'API REST con autenticación y documentación.',
    link: 'https://github.com/TU_USUARIO/proyecto-3'
  }
];
---

<Layout title="Mi portafolio | Astro" description="Portafolio de desarrollador con Astro y GitHub Pages">
  <main class="container">
    <header class="hero">
      <p class="tag">Disponible para trabajar</p>
      <h1>Hola, soy Tu Nombre 👋</h1>
      <p>
        Desarrollador/a enfocado/a en crear productos web rápidos, accesibles y con buena experiencia de usuario.
      </p>
      <div class="actions">
        <a href="mailto:tuemail@correo.com" class="btn primary">Contactarme</a>
        <a href="https://github.com/TU_USUARIO" class="btn" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </header>

    <section class="section">
      <h2>Sobre mí</h2>
      <p>
        Me especializo en JavaScript/TypeScript, Astro y React. Me gusta transformar ideas en productos listos para producción.
      </p>
    </section>

    <section class="section">
      <h2>Proyectos</h2>
      <div class="grid">
        {projects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href={project.link} target="_blank" rel="noreferrer">Ver proyecto →</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
