---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const {
  title,
  description = 'Portafolio personal creado con Astro'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
